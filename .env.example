# Frontend (Cloudflare Pages) — set in Pages project env / GitHub Variables, and in .env.local for local

# Cloudflare Worker API URL (local: http://localhost:3001)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Public site URL (production: https://ohshift.pages.dev)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Leave empty for local + Cloudflare Pages (was /OhShift on GitHub Pages)
NEXT_PUBLIC_BASE_PATH=""

# Frontend (GitHub Pages) — set these as GitHub repo Variables for CI, and in .env.local for dev

# Render Bun API URL (production example: https://ohshift-api.onrender.com)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Public site URL (production: https://youruser.github.io/OhShift)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# GitHub Pages project site only — repo name, e.g. /OhShift (leave empty for local dev & custom domains)
NEXT_PUBLIC_BASE_PATH=""

# SMTP is configured on the Render backend (backend/.env), not here

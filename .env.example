# Frontend (Cloudflare Pages) — set in GitHub Variables for CI, and in .env.local for local dev

# Cloudflare Worker API URL (local: http://localhost:3001)
VITE_API_URL="http://localhost:3001"

# Public site URL (production: https://ohshift.pages.dev)
VITE_APP_URL="http://localhost:3000"

# Leave empty for local + Cloudflare Pages (was /OhShift on GitHub Pages)
VITE_BASE_PATH=""

# "Try the live demo" target (production: https://demo.ohshifts.com). Empty = /demo on this site.
VITE_DEMO_URL=""

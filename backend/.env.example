# Local dev secrets for `wrangler dev` — copy into backend/.dev.vars
# (DATABASE_URL / DIRECT_URL / PORT are no longer used: the database is the D1 binding in wrangler.toml.)

# JWT signing — generate: openssl rand -base64 32
AUTH_SECRET=

# Frontend origin for CORS (local Vite dev, or https://your-app.pages.dev in production)
FRONTEND_URL="http://localhost:3000"

# Optional: comma-separated additional origins for CORS
# FRONTEND_URLS="https://ohshift.pages.dev,https://app.example.com"

# Workers AI runs through the [ai] binding — run `bunx wrangler login` once so
# `wrangler dev` can reach it. No account ID / API token needed here.

# Resend: sending-only API key, restricted to the verified sending domain.
RESEND_API_KEY=
EMAIL_FROM="OhShift <notifications@example.com>"
# Canonical frontend origin used for account links. HTTPS in production.
APP_URL="http://localhost:3000"

# Neon PostgreSQL
# Dashboard → Connection details → pooled (DATABASE_URL) and direct (DIRECT_URL)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Server (local Bun)
PORT=3001
NODE_ENV=development

# Frontend origin for CORS (local Pages/Next, or https://your-app.pages.dev in production)
FRONTEND_URL="http://localhost:3000"

# Optional: comma-separated additional origins for CORS
# FRONTEND_URLS="https://ohshift.pages.dev,https://app.example.com"

# JWT signing — generate: openssl rand -base64 32
AUTH_SECRET=

# Workers AI (local NL parse only — production uses the wrangler [ai] binding)
# Cloudflare dashboard → Account ID; API Tokens → create token with Workers AI permissions
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Email is deferred (Resend/Brevo later). Invite codes and temp passwords are returned in the API/UI.

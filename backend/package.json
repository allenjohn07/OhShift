    "db:studio": "prisma studio",
    "set-password": "bun run scripts/set-password.ts"
  },
  "dependencies": {
    "@auth/core": "^0.41.0",
    "@elysiajs/cors": "^1.4.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "elysia": "^1.4.18",
    "nodemailer": "^9.0.1",
    "prisma": "^6.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "latest",
    "@types/nodemailer": "^7.0.11",
    "typescript": "^5"
  }
}

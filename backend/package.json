{
  "name": "ohshift-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 3001",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "ai:eval": "echo 'run: bunx wrangler dev -c scripts/ai-eval/wrangler.toml --port 3098  then: curl -s localhost:3098 | bun scripts/ai-eval/report.ts'",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ohshift --local",
    "db:migrate:remote": "wrangler d1 migrations apply ohshift --remote",
    "db:studio": "drizzle-kit studio",
    "set-password": "bun run scripts/set-password.ts",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@libsql/client": "^0.18.0",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14"
  }
}
